{
  "ConnectionStrings": {
    "TimeReadyDb": "Host=localhost;Port=5432;Database=timeready;Username=timeready;Password=timeready"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "Jwt": {
    "Issuer": "TimeReady",
    "Audience": "TimeReadyClient",
    "SigningKey": "",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 7
  },
  "IdentitySeed": {
    "Admin": {
      "Email": "admin@timeready.local",
      "FullName": "TimeReady Administrator",
      "Password": ""
    },
    "Operator": {
      "Email": "operator@timeready.local",
      "FullName": "HR Operator",
      "Password": ""
    }
  },
  "AuditRetention": {
    "Enabled": true,
    "RetentionDays": 90,
    "PurgeEnabled": false,
    "ArchiveRetentionDays": 730,
    "IntervalHours": 24,
    "InitialDelaySeconds": 30,
    "BatchSize": 500
  },
  "RateLimiting": {
    "PermitLimit": 120,
    "WindowSeconds": 60
  },
  "Readiness": {
    "CriticalNegativeBalanceHours": -20,
    "WarningNegativeBalanceHours": -8,
    "ImminentVacationDays": 7,
    "LowVacationDaysThreshold": 3
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/timeready-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
