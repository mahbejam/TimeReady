# Copy to .env and fill in before running the production-shaped stack:
#   docker compose -f docker-compose.yml up --build
#
# Local development (`docker compose up`) merges docker-compose.override.yml,
# which already supplies throwaway secrets — no .env file required there.

# Database
POSTGRES_DB=timeready
POSTGRES_USER=timeready
POSTGRES_PASSWORD=change-me

# At least 32 characters. Generate one with:
#   openssl rand -base64 48
JWT_SIGNING_KEY=

# Administrator created on first start (required when not using the override file)
ADMIN_EMAIL=admin@timeready.local
ADMIN_PASSWORD=

# Browser origin allowed by CORS, and the published frontend port
FRONTEND_ORIGIN=http://localhost:4200
WEB_PORT=4200
